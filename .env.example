# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3:8b

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Scraper Configuration
BASE_URL=http://130.149.89.49:2080/v2016/index.html
MAX_WORKERS=5
REQUEST_DELAY=0.5

# Vector Database
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=abaqus_docs

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional ChatGPT-primary hybrid API (external Python 3.11 only)
HYBRID_API_HOST=127.0.0.1
HYBRID_API_PORT=8001
ABAQUSGPT_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Performance (optimized for speed)
TOP_K_RETRIEVAL=3      # Number of docs to retrieve (lower = faster)
MAX_TOKENS=300         # Max tokens for LLM response (lower = faster)
LLM_TEMPERATURE=0.2    # Lower = more focused, deterministic answers

